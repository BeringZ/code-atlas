{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://beringz.github.io/code-atlas/schema/concept.schema.json",
  "title": "Code Atlas 概念数据合同 v2",
  "description": "知识点（concept）统一数据合同 v2。在 v1 基础上新增微型课程字段：hook / mentalModel / executionSteps / walkthrough / realWorldExample / confusions / challenge / connections / nextStep。所有 v2 字段可选，向后兼容（if (concept.hook) renderHook()）。L3 v2 概念（含 hook 字段）须满足完整微型课程合同。",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "description": "知识点唯一 ID" },
    "status": { "type": "string", "enum": ["published", "draft"] },
    "level": { "type": "string", "enum": ["L1", "L2", "L3", "L4"] },
    "module_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },

    "objectives": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "core": { "type": "string", "minLength": 1 },

    "estimatedTime": { "type": "integer", "description": "预计学习时间（分钟）", "minimum": 1 },
    "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"], "description": "难度等级" },

    "hook": {
      "type": "object",
      "description": "问题引入：制造认知冲突，让用户先猜再学",
      "required": ["question", "options", "answer"],
      "properties": {
        "question": { "type": "string" },
        "code": { "type": "string", "description": "引发问题的代码片段" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "answer": { "type": "integer", "minimum": 0 },
        "explanation": { "type": "string", "description": "为什么答案是正确的" }
      }
    },

    "mentalModel": {
      "type": "object",
      "description": "心智模型：用 HTML/CSS 图示建立抽象概念的视觉锚点",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "diagram": { "type": "string", "description": "HTML 片段，直接渲染为可视化图示" }
      }
    },

    "executionSteps": {
      "type": "array",
      "description": "程序执行过程：逐步展示代码行与变量状态变化",
      "items": {
        "type": "object",
        "required": ["line", "explanation"],
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "explanation": { "type": "string" },
          "state": { "type": "object", "description": "当前行执行后的变量状态 { varName: value }" }
        }
      }
    },

    "walkthrough": {
      "type": "array",
      "description": "逐行解释：最小示例的每行代码含义",
      "items": {
        "type": "object",
        "required": ["line", "text"],
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" }
        }
      }
    },

    "realWorldExample": {
      "type": "object",
      "description": "真实场景：最小示例之后的实际应用案例",
      "properties": {
        "title": { "type": "string" },
        "problem": { "type": "string", "description": "要解决的实际问题" },
        "code": { "type": "string" },
        "language": { "type": "string", "description": "代码使用的语言" },
        "connections": { "type": "array", "items": { "type": "string" }, "description": "连接到的其他知识点 ID" }
      }
    },

    "confusions": {
      "type": "array",
      "description": "易混概念：并排对比容易混淆的概念对",
      "items": {
        "type": "object",
        "required": ["left", "right", "explanation"],
        "properties": {
          "left": { "type": "string" },
          "right": { "type": "string" },
          "explanation": { "type": "string" },
          "leftExample": { "type": "string" },
          "rightExample": { "type": "string" }
        }
      }
    },

    "challenge": {
      "type": "object",
      "description": "30 秒挑战：要求用户主动输出一次",
      "properties": {
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "hints": { "type": "array", "items": { "type": "string" } },
        "solution": { "type": "string", "description": "参考答案代码" },
        "solutionOutput": { "type": "string", "description": "预期输出" }
      }
    },

    "connections": {
      "type": "object",
      "description": "知识连接：当前知识点在知识图谱中的位置",
      "properties": {
        "current": { "type": "string", "description": "当前所在的知识域" },
        "diagram": { "type": "string", "description": "HTML 片段，知识图谱可视化" },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "related": { "type": "array", "items": { "type": "string" } },
        "next": { "type": "array", "items": { "type": "string" } }
      }
    },

    "nextStep": {
      "type": "object",
      "description": "下一步：学完本节后的推荐路径",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetId": { "type": "string", "description": "目标知识点 ID" }
      }
    },

    "variants": {
      "type": "object",
      "description": "六语言同题实现",
      "properties": {
        "python": { "$ref": "#/definitions/variant" },
        "javascript": { "$ref": "#/definitions/variant" },
        "java": { "$ref": "#/definitions/variant" },
        "cpp": { "$ref": "#/definitions/variant" },
        "go": { "$ref": "#/definitions/variant" },
        "rust": { "$ref": "#/definitions/variant" }
      }
    },

    "comparisonDimensions": {
      "type": "array",
      "items": { "type": "string", "enum": ["type-checking", "mutability", "memory-model", "failure-mode", "idiomatic-style", "runtime-cost", "unicode-representation", "error-propagation", "ownership"] }
    },
    "lang_diff": { "type": "string" },
    "commonTask": { "type": "object" },
    "transferExercises": { "type": "array" },
    "acceptanceTests": { "type": "array" },

    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "cause": { "type": "string" },
          "fix": { "type": "string" },
          "variantCode": { "type": "string", "description": "v2: 变体问题——为什么类似代码合法" }
        }
      }
    },

    "exercises": {
      "type": "array",
      "description": "练习：支持四级难度 A-识别 / B-预测 / C-修改 / D-生成",
      "items": {
        "type": "object",
        "required": ["type", "question", "options", "answer"],
        "properties": {
          "id": { "type": "string", "description": "练习唯一 ID，如 value.binding.ex01" },
          "level": { "type": "string", "enum": ["A", "B", "C", "D"], "description": "A-识别 B-预测 C-修改 D-生成" },
          "type": { "type": "string", "enum": ["concept", "read", "output", "debug", "migrate", "design", "pair", "fill"] },
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "answer": { "type": "integer", "minimum": 0 },
          "feedback": { "type": "string" },
          "starterCode": { "type": "string", "description": "C/D 级练习的起始代码" }
        }
      }
    },

    "deep_dive": { "type": "string" },
    "summary": { "type": "string" },
    "next": { "type": "array", "items": { "type": "string" } },
    "related_advanced": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "status", "module_id", "title"],
  "additionalProperties": true,
  "definitions": {
    "variant": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "minimal_code": { "type": "string" },
        "semantic_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "start", "end"],
            "properties": {
              "role": { "type": "string" },
              "start": { "type": "integer", "minimum": 1 },
              "end": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "syntax_notes": { "type": "array", "items": { "type": "string" } },
        "semantic_notes": { "type": "array", "items": { "type": "string" } },
        "idioms": { "type": "array", "items": { "type": "string" } },
        "pitfalls": { "type": "array", "items": { "type": "string" } },
        "comparison": { "type": "object" }
      },
      "required": ["minimal_code"]
    }
  }
}
